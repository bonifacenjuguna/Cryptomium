# Port the API listens on (Railway/Render set this for you).
PORT=3001

# Which websites may connect. Comma separated. Supports wildcards like
# *.vercel.app. Use * to allow everyone (fine: the data is public).
CORS_ORIGIN=*

# How often exchange prices are polled, in milliseconds (min 1000).
POLL_INTERVAL_MS=2000

# CoinGecko is used for 24h change and as a last-resort price source.
# Optional Demo or Pro key; the server detects which one it is.
COINGECKO_API_KEY=
COINGECKO_INTERVAL_MS=30000
