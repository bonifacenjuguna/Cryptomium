# Telegram bot token from @BotFather
BOT_TOKEN=

# Your personal Telegram numeric user ID (get it from @userinfobot).
# Only this ID can control the bot — everyone else is silently ignored.
OWNER_TELEGRAM_ID=

# Provided automatically by Railway when you add the Postgres and Redis
# plugins to this project — you shouldn't need to set these by hand.
DATABASE_URL=
REDIS_URL=

# Optional overrides (sensible defaults are used if omitted)
WATERMARK_HANDLE=@CryptomiumApp
DEFAULT_TIMEZONE=Africa/Nairobi
POLL_INTERVAL_MS=30000

# Optional: a free CoinGecko "demo" API key (from coingecko.com/en/api).
# Not required, but raises CoinGecko's rate limit for prices and logo downloads.
# The bot auto-detects a Demo vs a paid Pro key, so upgrading your CoinGecko
# plan needs no other change here — just keep this set to whatever key you
# currently have (unless CoinGecko issues you a brand new key string on
# upgrade, in which case paste the new one in here).
COINGECKO_API_KEY=

# ---- Posting pace and limits (all optional) ---------------------------------
# Pause between consecutive banners, in milliseconds.
POST_DELAY_MS=1200
# Most automatic alerts per rolling hour (0 = no cap). Held-back alerts are
# not lost; they post as soon as there is room again.
MAX_AUTO_POSTS_PER_HOUR=0
# Minimum seconds between two automatic alerts for the same coin (0 = off).
MIN_POST_GAP_SECONDS=0
# Tries per failing alert (one per poll) before it is dropped.
ALERT_MAX_ATTEMPTS=5

# ---- Housekeeping (all optional) ---------------------------------------------
# Delete post history older than this many days (0 = keep forever).
POST_LOG_RETENTION_DAYS=365
# Minimum minutes between two "price source" heads-up DMs of the same kind.
SOURCE_ALERT_COOLDOWN_MIN=60
# Minutes between retries for logos that failed to download.
LOGO_RETRY_MIN=30

# ---- Website API for the website dashboard (all optional) ---------------------
# Set API_ENABLED=false to turn the website API off.
API_ENABLED=true
# PORT is provided by Railway automatically. Do not set it there.
# PORT=3000
# Site(s) allowed to call the API, comma-separated. Use your Vercel address,
# e.g. https://my-dashboard.vercel.app . "*" (default) allows any site.
ALLOWED_ORIGIN=*
# How often the website gets fresh prices (ms) while the bot's data source is
# an exchange (Binance first / Kraken first). They update in real time.
API_REFRESH_MS=5000
# Website live exchange feed interval (ms) and max open live streams.
API_LIVE_REFRESH_MS=2000
API_MAX_STREAMS=1500
# Same, for aggregator sources (Auto, CoinGecko only, CoinPaprika, Average).
# They only update about once a minute, so faster refreshing would repeat the
# same numbers and use up their request limits.
API_SLOW_REFRESH_MS=30000
# Requests allowed per visitor per minute (the website polls every few seconds).
API_RATE_LIMIT_PER_MIN=240
# Reverse proxies in front of the API (Railway = 1). Used to find the real visitor address.
TRUSTED_PROXY_HOPS=1

# ---- App notifications / Web Push (optional) ---------------------------------
# Leave these empty to keep notifications off. Create the pair with:  npm run vapid
# The private key is a SECRET: set it only here (Railway variables), never in the website or in git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:you@example.com (or your https site address)
VAPID_SUBJECT=
# How often (ms) devices' price alerts are compared with live prices. Only runs while an alert is armed.
PUSH_CHECK_MS=15000
# Most devices that can register, and days of silence after which a device is forgotten.
PUSH_MAX_DEVICES=20000
PUSH_DEVICE_TTL_DAYS=120
# ALLOWED_ORIGIN above should be your real site address(es) once notifications are on, not "*".
