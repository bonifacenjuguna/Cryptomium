# Telegram bot token from @BotFather
BOT_TOKEN=

# Your personal Telegram numeric user ID (get it from @userinfobot).
# Only this ID can control the bot — everyone else is silently ignored.
OWNER_TELEGRAM_ID=

# Provided automatically by Railway when you add the Postgres and Redis
# plugins to this project — you shouldn't need to set these by hand.
DATABASE_URL=
REDIS_URL=

# Optional overrides (sensible defaults are used if omitted)
WATERMARK_HANDLE=@priceping
DEFAULT_TIMEZONE=Africa/Nairobi
POLL_INTERVAL_MS=30000

# Optional: a free CoinGecko "demo" API key (from coingecko.com/en/api).
# Not required — CoinGecko works keyless — but raises its rate limit for
# both prices and logo downloads.
COINGECKO_API_KEY=
# Only set this to "pro" if COINGECKO_API_KEY above is a paid Pro key
# (not the free demo key). Leave unset/blank otherwise.
COINGECKO_API_PLAN=

# Optional: a CoinMarketCap API key (from coinmarketcap.com/api — CMC has no
# keyless tier, even on its free Basic plan). Adds CoinMarketCap as an extra
# backup price source (Settings > Data source > Auto / Kraken first) and as
# an extra logo source. Everything works fine without it — Kraken,
# CoinPaprika and DexScreener are already keyless backups.
COINMARKETCAP_API_KEY=
